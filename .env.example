# ==============================================================================
# Nexa AI - Environment Variables Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Replace the placeholder values with your real API credentials.
# 3. Never commit your actual .env file or API keys to version control.
# ==============================================================================

# [Required] Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [Optional] Default Models Configuration
# Text, Code & Vision model (gemini-3.5-flash-lite is the lower-latency option)
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Native Image Generation model (Options: gemini-nano-banana-2.1, imagen-3.0-generate-002)
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
